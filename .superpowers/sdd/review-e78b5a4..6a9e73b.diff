diff --git a/backend/scripts/seed_admin.py b/backend/scripts/seed_admin.py new file mode 100644 index 0000000..2f73bbe --- /dev/null +++ b/backend/scripts/seed_admin.py @@ -0,0 +1,67 @@ +import argparse +import asyncio +import getpass +import sys + +from sqlalchemy import select, text +from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine + +from app.core.config import settings +from app.core.security import get_password_hash +from app.models.admin import AdminSettings + + +async def seed_admin(email: str, password: str) -> None: +    database_url = settings.DATABASE_URL or "postgresql+asyncpg://dental_dev:dental_dev_pass@localhost:5432/dental_clinic_dev" + +    engine = create_async_engine(database_url, echo=False) +    session_factory = async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False) + +    try: +        async with session_factory() as session: +            async with session.begin(): +                result = await session.execute(select(AdminSettings).where(AdminSettings.id == 1)) +                existing = result.scalar_one_or_none() + +                if existing: +                    existing.email = email +                    existing.password_hash = get_password_hash(password) +                else: +                    session.add(AdminSettings( +                        id=1, +                        email=email, +                        password_hash=get_password_hash(password), +                    )) + +            print(f"Admin account seeded successfully: {email}") +    except Exception as e: +        print(f"Error seeding admin account: {e}", file=sys.stderr) +        sys.exit(1) +    finally: +        await engine.dispose() + + +def main() -> None: +    parser = argparse.ArgumentParser(description="Seed the initial admin account.") +    parser.add_argument("--email", type=str, help="Admin email address") +    parser.add_argument("--password", type=str, help="Admin password") +    args = parser.parse_args() + +    email = args.email +    password = args.password + +    if not email: +        email = input("Admin email: ").strip() + +    if not password: +        password = getpass.getpass("Admin password: ").strip() + +    if not email or not password: +        print("Email and password are required.", file=sys.stderr) +        sys.exit(1) + +    asyncio.run(seed_admin(email, password)) + + +if __name__ == "__main__": +    main()
